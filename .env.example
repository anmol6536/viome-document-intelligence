GEMINI_API_KEY=changeme
DEFAULT_AI_MODEL=gemini
MAX_TRANSPORT_RETRIES=2
MAX_VALIDATION_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0
GEMINI_REQUEST_TIMEOUT_SECONDS=60.0
# Reserved port block for this project: 8020 (app), 8021 (validator) -
# see docker-compose.yml. Only matters when running the app locally
# (e.g. uvicorn) against a validator started separately (docker compose
# or docker run) - update if you change the validator's host port.
FHIR_VALIDATOR_URL=http://localhost:8021
MAX_UPLOAD_BYTES=20971520

# Gateway Aidbox instance to register the viome-lab-observation profile
# with (used by `make init` / `make aidbox-register`, not by the app itself).
AIDBOX_HOST=localhost
AIDBOX_PORT=8080
AIDBOX_SECRET=changeme
